{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw compile*)",
      "Bash(./mvnw test*)",
      "Bash(./mvnw verify*)",
      "Bash(./mvnw -B verify*)",
      "Bash(./mvnw -q test*)",
      "Bash(./mvnw -q verify*)",
      "Bash(./mvnw spring-boot:test-run*)",
      "PowerShell(./mvnw compile*)",
      "PowerShell(./mvnw test*)",
      "PowerShell(./mvnw verify*)",
      "PowerShell(./mvnw -B verify*)",
      "PowerShell(./mvnw spring-boot:test-run*)",
      "PowerShell(.\\mvnw compile*)",
      "PowerShell(.\\mvnw test*)",
      "PowerShell(.\\mvnw verify*)",
      "PowerShell(.\\mvnw spring-boot:test-run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git branch -vv*)",
      "Bash(git branch --list*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git fetch*)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch -a*)",
      "PowerShell(git branch -vv*)",
      "PowerShell(git branch --list*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
